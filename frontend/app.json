{
  "expo": {
    "name": "TYRE KHATA",
    "slug": "tyrebook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.tireinventoryapp.k5wo00",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan invoices and tyre labels for stock entry",
        "NSPhotoLibraryUsageDescription": "Attach invoice photos for smart scan",
        "NSPhotoLibraryAddUsageDescription": "Save generated invoice PDFs to Photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000F26"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.tireinventory.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#006B5F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach invoice photos for smart scan",
          "cameraPermission": "Scan invoices and tyre labels for stock entry"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "extraProguardRules": "-keep class com.google.firebase.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
