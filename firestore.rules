rules_version = '2';

// TyreBook multi-tenant Firestore security rules.
//
// TENANT MODEL
//   users/{uid}                — global user profile. Read/write only by
//                                the owner uid or a super_admin.
//                                Role / shopId / uid / email / active are
//                                LOCKED for self-updates (privilege
//                                escalation defence).
//   shopInvites/{emailKey}     — global pending invites.
//   shops/{shopId}             — tenant root doc. Members can read; only
//                                Shop Admin (and Super Admin) may write
//                                non-subscription profile fields.
//   shops/{shopId}/<subcol>/*  — per-collection least-privilege rules
//                                (see the per-collection blocks below).
//                                There is NO `{document=**}` fallback:
//                                any subcollection not listed here is
//                                implicitly denied so future additions
//                                cannot silently bypass RBAC.
//
// ROLES
//   super_admin   Platform owner. Identified authoritatively by the auth
//                 token email allow-list (see `superAdminEmails()`).
//                 Bypasses tenant boundaries.
//   shop_admin    Tenant owner. Full CRUD inside their own shop's
//                 subcollections; may not modify subscription-controlled
//                 fields on the tenant root doc.
//   staff         Tenant employee. Least-privilege inside the shop —
//                 CANNOT delete tyres, edit pricing, touch purchases,
//                 change settings (except two invoice counters written
//                 by the transactional invoice-number reservation), or
//                 manage members / users / roles.
//
// DEPLOY (from a machine with Firebase CLI credentials):
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Identity helpers
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myUserSafe() {
      // Returns null instead of throwing if the doc doesn't exist yet
      // (edge case: right after signup, before users/{uid} is written).
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myUser()
        : null;
    }

    function myRole() {
      let u = myUserSafe();
      return u == null ? "" : (u.role == null ? "" : u.role);
    }

    function myShopId() {
      let u = myUserSafe();
      return u == null ? "" : (u.shopId == null ? "" : u.shopId);
    }

    // Platform Super Admin allow-list. Keep this in sync with
    // EXPO_PUBLIC_SUPER_ADMIN_EMAILS in frontend/.env. This is the
    // AUTHORITATIVE identifier for a Super Admin at the rules layer —
    // storing role="super_admin" in users/{uid} alone is not sufficient
    // (see the users/{uid} CREATE / UPDATE gating below).
    function superAdminEmails() {
      return ['admin@tyrebook.com'];
    }

    function isSuperAdminByEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email in superAdminEmails();
    }

    function isSuperAdmin() {
      // Defence-in-depth: EITHER the auth-token email is in the allow-list
      // OR the users/{uid}.role says super_admin. Because the users/{uid}
      // write rules below FORBID a normal user from setting role at all
      // (create) and from changing role on update, the second branch can
      // only be true if a legitimate Super Admin previously wrote it.
      return isSuperAdminByEmail()
        || (isSignedIn() && myRole() == "super_admin");
    }

    function isShopAdminOf(shopId) {
      return isSignedIn() && myRole() == "shop_admin" && myShopId() == shopId;
    }

    function isStaffOf(shopId) {
      return isSignedIn() && myRole() == "staff" && myShopId() == shopId;
    }

    function isMemberOf(shopId) {
      return isSignedIn()
        && (myRole() == "shop_admin" || myRole() == "staff")
        && myShopId() == shopId;
    }

    // ============================================================
    // users/{uid}
    // ============================================================
    // PRIVILEGE-ESCALATION SAFETY:
    //   1. CREATE   — a signed-in user may create ONLY their own
    //                 users/{uid} doc. Role must be 'staff' or
    //                 'shop_admin' (or 'super_admin' AND email in the
    //                 allow-list). `shop_admin` further requires that
    //                 shops/{shopId}.ownerUid matches the caller.
    //                 `staff` further requires a matching invite doc at
    //                 shopInvites/{authEmail.trim().lower()} whose
    //                 shopId matches the claimed shopId and whose role
    //                 is 'staff' — a rogue user CANNOT self-register
    //                 as staff of any shop without a valid,
    //                 server-issued invite.
    //   2. UPDATE   — self-updates MAY change name / lastLoginAt /
    //                 other non-critical fields, but MUST NOT change
    //                 role, shopId, uid, email, active. Only Super
    //                 Admin can touch those.
    //   3. DELETE   — Super Admin only.
    //
    // These rules are the reason a rogue client cannot self-elevate to
    // super_admin (or migrate to another shop) by writing directly
    // through the Firebase SDK.

    function protectedUserFields() {
      return ['role', 'shopId', 'uid', 'email', 'active'];
    }

    function userUpdateChangesProtectedFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(protectedUserFields());
    }

    function isValidNewShopAdmin(uid) {
      // The claimed shopId must exist AND be owned by this user. This
      // covers the fresh-signup path (hydrateAppUser first creates the
      // shop with ownerUid=user.uid and then writes users/{uid}).
      let sid = request.resource.data.shopId;
      return sid is string
        && sid.size() > 0
        && exists(/databases/$(database)/documents/shops/$(sid))
        && get(/databases/$(database)/documents/shops/$(sid)).data.ownerUid == uid;
    }

    function isValidNewStaff() {
      // Rules-verifiable invite check. The invite doc id must equal
      // `request.auth.token.email.trim().lower()` — this exactly matches
      // the JS `inviteKey()` helper in src/firebase/invites.ts. Firestore
      // rules cannot execute regex replacement, so the invite key format
      // was deliberately switched from a slug to the raw normalised
      // email so both layers can compute the same value.
      //
      // A rogue signed-in user who does NOT have a matching invite doc
      // cannot pass this check, even if they know the target shopId.
      // Boolean short-circuiting on `&&` guarantees `.trim().lower()`
      // never runs against a null email, and the `exists(...)` guard
      // prevents `get(...)` from throwing on a missing invite.
      let sid = request.resource.data.shopId;
      return sid is string
        && sid.size() > 0
        && request.auth.token.email != null
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0
        && exists(/databases/$(database)/documents/shopInvites/$(request.auth.token.email.trim().lower()))
        && get(/databases/$(database)/documents/shopInvites/$(request.auth.token.email.trim().lower())).data.shopId == sid
        && get(/databases/$(database)/documents/shopInvites/$(request.auth.token.email.trim().lower())).data.role == 'staff';
    }

    match /users/{uid} {
      allow read: if isSignedIn()
                     && (request.auth.uid == uid || isSuperAdmin());

      allow create: if isSignedIn()
                       && request.auth.uid == uid
                       && request.resource.data.uid == uid
                       && (
                            (request.resource.data.role == 'shop_admin'
                             && isValidNewShopAdmin(uid))
                         || (request.resource.data.role == 'staff'
                             && isValidNewStaff())
                         || (request.resource.data.role == 'super_admin'
                             && isSuperAdminByEmail())
                       );

      allow update: if isSignedIn()
                       && (
                            isSuperAdmin()
                         || (request.auth.uid == uid
                             && !userUpdateChangesProtectedFields())
                       );

      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // shopInvites/{key}
    // ============================================================
    match /shopInvites/{key} {
      // Signup needs to look up its own invite by email BEFORE the
      // users/{uid} doc is created — so allow any signed-in user to
      // read. Writes are limited to shop_admins (of the target shop)
      // and super_admins. The invitee can also delete their own
      // invite once consumed (identified by the email prefix,
      // verified best-effort).
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                       && (isSuperAdmin()
                           || (myRole() == "shop_admin"
                               && request.resource.data.shopId == myShopId()));
      allow update: if isSignedIn()
                       && (isSuperAdmin()
                           || (myRole() == "shop_admin"
                               && resource.data.shopId == myShopId()));
      allow delete: if isSignedIn()
                       && (isSuperAdmin()
                           || (myRole() == "shop_admin"
                               && resource.data.shopId == myShopId())
                           || resource.data.email == request.auth.token.email);
    }

    // ============================================================
    // shops/{shopId}
    // ============================================================
    // Protected subscription / identity fields on the shop root doc.
    // Only Super Admin (or a trusted backend using the Firebase Admin
    // SDK, which bypasses these rules entirely) may change these.
    function protectedShopFields() {
      return [
        // Subscription state actually used by the current Shop type:
        "status",              // trial | active | expired | suspended
        "trialEndsAt",
        "planExpiresAt",
        // Identity / audit fields that Shop Admin must never rewrite:
        "id",
        "ownerUid",
        "ownerEmail",
        "createdAt",
        "isLegacyMigrationTarget",
        // Reserved names for future subscription/billing controls so
        // a client that starts writing them cannot bypass this rule:
        "subscriptionStatus",
        "plan",
        "subscriptionEndsAt",
        "suspended",
        "billingStatus",
        "paymentStatus",
      ];
    }

    function shopAdminUpdateSafe(shopId) {
      // Shop Admin may only update the tenant root doc when the SET of
      // keys touched by this update does NOT intersect the protected
      // list. `affectedKeys()` returns every key that differs between
      // the new and old document — added, changed, or removed.
      return isShopAdminOf(shopId)
        && !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(protectedShopFields());
    }

    match /shops/{shopId} {
      // Anyone signed in can attempt to create a new shop (auto-
      // provisioning during signup) — but only when they are named as
      // the owner in the create payload.
      allow create: if isSignedIn()
                       && request.resource.data.ownerUid == request.auth.uid;

      // Reads: Super Admin OR any current member of the shop.
      allow read: if isSuperAdmin() || isMemberOf(shopId);

      // Updates: Super Admin can touch anything (subscription
      // lifecycle, suspension, etc.). Shop Admin may only update
      // non-protected profile fields (name, phone, address, gstin,
      // notes, invoice prefix, etc.). Staff can never update the
      // shop root doc.
      allow update: if isSuperAdmin() || shopAdminUpdateSafe(shopId);

      // Deletion is strictly Super Admin.
      allow delete: if isSuperAdmin();

      // ============================================================
      // TENANT SUBCOLLECTIONS — least-privilege per-collection rules
      // ============================================================

      // --- Inventory: tyres ---------------------------------------
      // Staff may adjust `currentStock` (needed by the transactional
      // sale stock deduction and Maal Aaya/Gaya movements) but NOT
      // edit any other field (pricing, brand, size, rack, ...). Only
      // Shop Admin can create / delete tyres or edit pricing.
      match /tyres/{tyreId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow create, delete: if isSuperAdmin() || isShopAdminOf(shopId);
        allow update: if isSuperAdmin()
                        || isShopAdminOf(shopId)
                        || (isStaffOf(shopId)
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys()
                                 .hasOnly(['currentStock', 'updatedAt']));
      }

      // --- Billing: sales -----------------------------------------
      // Staff CAN create and edit sales inside their own shop. Only
      // Shop Admin (or Super Admin) can delete a sale — deletion is
      // a sensitive audit event.
      match /sales/{saleId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow create, update: if isSuperAdmin() || isMemberOf(shopId);
        allow delete: if isSuperAdmin() || isShopAdminOf(shopId);
      }

      // --- Customers ----------------------------------------------
      match /customers/{customerId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow create, update: if isSuperAdmin() || isMemberOf(shopId);
        allow delete: if isSuperAdmin() || isShopAdminOf(shopId);
      }

      // --- Vehicles (customer vehicle registry) -------------------
      match /vehicles/{vehicleId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow create, update: if isSuperAdmin() || isMemberOf(shopId);
        allow delete: if isSuperAdmin() || isShopAdminOf(shopId);
      }

      // --- Khata (credit ledger) ----------------------------------
      match /khata/{khataId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow create, update: if isSuperAdmin() || isMemberOf(shopId);
        allow delete: if isSuperAdmin() || isShopAdminOf(shopId);
      }

      // --- Stock movements (append-only log) ----------------------
      match /stock_movements/{movementId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow create: if isSuperAdmin() || isMemberOf(shopId);
        allow update, delete: if isSuperAdmin() || isShopAdminOf(shopId);
      }

      // --- Purchases (Shop Admin only) ----------------------------
      // Purchases move money and adjust inventory pricing — Staff
      // must never touch this collection in any way.
      match /purchases/{purchaseId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow write: if isSuperAdmin() || isShopAdminOf(shopId);
      }

      // --- Settings -----------------------------------------------
      // Shop Admin owns all settings. Staff may ONLY update the two
      // invoice-number counters (via the transactional
      // reserveInvoiceNumber flow) — no other field. Staff is also
      // permitted to CREATE settings/{doc} because the very first
      // sale in a brand-new tenant triggers `tx.set(...)` on
      // settings/shop when the doc is missing; this is tenant-scoped
      // and cannot leak across shops.
      match /settings/{settingId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow create: if isSuperAdmin() || isMemberOf(shopId);
        allow update: if isSuperAdmin()
                        || isShopAdminOf(shopId)
                        || (isStaffOf(shopId)
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys()
                                 .hasOnly(['nextInvoiceNumber',
                                           'nextKachaNumber',
                                           'updatedAt',
                                           'createdAt']));
        allow delete: if isSuperAdmin() || isShopAdminOf(shopId);
      }

      // --- Members (team roster mirror) ---------------------------
      // Shop Admin manages the team. A user may write/refresh their
      // OWN member doc on login (mirror of users/{uid}) but must not
      // escalate their own role or impersonate someone else.
      match /members/{memberUid} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow create: if isSuperAdmin()
                        || isShopAdminOf(shopId)
                        || (request.auth.uid == memberUid
                            && isMemberOf(shopId));
        allow update: if isSuperAdmin()
                        || isShopAdminOf(shopId)
                        || (request.auth.uid == memberUid
                            && isMemberOf(shopId)
                            && !request.resource.data.diff(resource.data)
                                 .affectedKeys()
                                 .hasAny(['role', 'uid', 'email']));
        allow delete: if isSuperAdmin() || isShopAdminOf(shopId);
      }

      // --- Master data --------------------------------------------
      // brands / tyreModels / tyreSizes / vehicleCategories /
      // suppliers. Read for any member; mutations for Shop Admin
      // only (Staff must never edit business master data).
      match /brands/{docId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow write: if isSuperAdmin() || isShopAdminOf(shopId);
      }
      match /tyreModels/{docId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow write: if isSuperAdmin() || isShopAdminOf(shopId);
      }
      match /tyreSizes/{docId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow write: if isSuperAdmin() || isShopAdminOf(shopId);
      }
      match /vehicleCategories/{docId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow write: if isSuperAdmin() || isShopAdminOf(shopId);
      }
      match /suppliers/{docId} {
        allow read: if isSuperAdmin() || isMemberOf(shopId);
        allow write: if isSuperAdmin() || isShopAdminOf(shopId);
      }

      // NOTE: There is intentionally NO `match /{document=**}`
      // fallback inside shops/{shopId}. Any subcollection not listed
      // above is denied by default so future collections cannot
      // silently bypass RBAC — extend this file explicitly.
    }
  }
}
