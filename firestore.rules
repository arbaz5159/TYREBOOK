rules_version = '2';

// TyreBook multi-tenant Firestore security rules.
//
// Tenant model:
//   users/{uid}              — global user profile. Read/write only by
//                              the owner uid or a super_admin.
//   shopInvites/{emailKey}   — global pending invites. Any signed-in user
//                              can read (needed by signup flow to consume
//                              their own invite) and shop_admins /
//                              super_admins can create/revoke.
//   shops/{shopId}           — tenant root doc. Members of that shop can
//                              read; only the shop_admin (and super_admin)
//                              can write.
//   shops/{shopId}/**        — every subcollection is fully readable and
//                              writable by any member of that shop. A
//                              super_admin can also access any shop.
//
// Deploy from Firebase CLI:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myUserSafe() {
      // Safe variant that returns null instead of throwing if the doc
      // doesn't exist yet (edge case: right after signup, before the
      // users/{uid} doc has been created).
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? myUser()
        : null;
    }

    function myRole() {
      let u = myUserSafe();
      return u == null ? "" : (u.role == null ? "" : u.role);
    }

    function myShopId() {
      let u = myUserSafe();
      return u == null ? "" : (u.shopId == null ? "" : u.shopId);
    }

    function isSuperAdmin() {
      return isSignedIn() && myRole() == "super_admin";
    }

    function isShopAdminOf(shopId) {
      return isSignedIn() && myRole() == "shop_admin" && myShopId() == shopId;
    }

    function isMemberOf(shopId) {
      return isSignedIn()
        && (myRole() == "shop_admin" || myRole() == "staff")
        && myShopId() == shopId;
    }

    // ------------------------------------------------------------------
    // users/{uid}
    // ------------------------------------------------------------------
    match /users/{uid} {
      // A user may read/write their own doc; a super_admin may read/write
      // anyone's doc (to run migrations and manage roles).
      allow read, write: if isSignedIn()
                        && (request.auth.uid == uid || isSuperAdmin());
    }

    // ------------------------------------------------------------------
    // shopInvites/{key}
    // ------------------------------------------------------------------
    match /shopInvites/{key} {
      // Signup needs to look up its own invite by email BEFORE the
      // users/{uid} doc is created — so allow any signed-in user to read.
      // Writes are limited to shop_admins (of the target shop) and
      // super_admins. The invitee can also delete their own invite once
      // consumed (identified by the email prefix, verified best-effort).
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                   && (isSuperAdmin() || (myRole() == "shop_admin"
                        && request.resource.data.shopId == myShopId()));
      allow update: if isSignedIn()
                   && (isSuperAdmin() || (myRole() == "shop_admin"
                        && resource.data.shopId == myShopId()));
      allow delete: if isSignedIn()
                   && (isSuperAdmin() || (myRole() == "shop_admin"
                        && resource.data.shopId == myShopId())
                        // The invitee themselves may consume the invite
                        // during signup (email-key match).
                        || resource.data.email == request.auth.token.email);
    }

    // ------------------------------------------------------------------
    // shops/{shopId}
    // ------------------------------------------------------------------
    //
    // Protected subscription / identity fields. Only Super Admin (or a
    // trusted backend using the Firebase Admin SDK, which bypasses these
    // rules entirely) may change these. Shop Admin can update the rest
    // of the shop profile (name, notes, etc.).
    //
    // If the app adds new subscription-control fields in the future, add
    // them to this list — never accept an unknown field name silently.
    // ------------------------------------------------------------------
    function protectedShopFields() {
      return [
        // Fields actually in use by the current Shop interface:
        "status",              // trial | active | expired | suspended
        "trialEndsAt",
        "planExpiresAt",
        // Identity / audit fields that Shop Admin must never rewrite:
        "id",
        "ownerUid",
        "ownerEmail",
        "createdAt",
        "isLegacyMigrationTarget",
        // Reserved names for future subscription/billing controls so a
        // client that starts writing them cannot bypass this rule:
        "subscriptionStatus",
        "plan",
        "subscriptionEndsAt",
        "suspended",
        "billingStatus",
        "paymentStatus",
      ];
    }

    function shopAdminUpdateSafe(shopId) {
      // Shop Admin may only update a shop root doc when the SET of keys
      // touched by this update does NOT intersect the protected list.
      // `affectedKeys()` returns every key that differs between the new
      // and old document — added, changed, or removed.
      return isShopAdminOf(shopId)
        && !request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasAny(protectedShopFields());
    }

    match /shops/{shopId} {
      // Anyone signed in can attempt to create a new shop (that's how
      // signup auto-provisions a fresh tenant) — but only when they are
      // named as the owner in the create payload.
      allow create: if isSignedIn()
                   && request.resource.data.ownerUid == request.auth.uid;

      // Reads: super_admin OR any current member of the shop.
      allow read: if isSuperAdmin() || isMemberOf(shopId);

      // Updates: Super Admin can touch anything (subscription lifecycle,
      // suspension, etc.). Shop Admin may only update non-protected
      // profile fields (name, phone, address, gstin, notes, invoice
      // prefix, etc.). Staff can never update the shop root doc.
      allow update: if isSuperAdmin() || shopAdminUpdateSafe(shopId);

      // Deletion is strictly Super Admin — a Shop Admin must never be
      // able to remove their own tenant root doc.
      allow delete: if isSuperAdmin();

      // ----------------------------------------------------------------
      // shops/{shopId}/** — ALL tenant-scoped data lives here.
      // ----------------------------------------------------------------
      match /{document=**} {
        allow read, write: if isSuperAdmin() || isMemberOf(shopId);
      }
    }
  }
}
